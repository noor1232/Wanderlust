<% layout("/layouts/boilerplate.ejs") %>
<div class="row">
  <div class="col-8 offset-2">
    <h3 class="mt-3 mb-3"><b><%= listing.title %></b></h3>

    <div class="card">
      <img
        src="<%= listing.image.url %>"
        class="card-img-top show-image"
        alt="listing image"
      />

      <div class="card-body">
        <p class="card-text pd-5 mt-2">
          <%= listing.location %> <b>,</b><%= listing.country %><br />
          <br />
          <%= listing.description %><br />
          &#x20B9;<%= listing.price != null ? listing.price.toLocaleString("en-IN") : "Price not available" %><br /><br />
          
        </p>
      </div>
    </div>

    <div class="btns mt-3 mb-4 d-flex gap-3">
      <a
        class="btn btn-dark"
        href="/listings/<%= listing._id %>/edit"
      >
        Edit
      </a>

      <form
        action="/listings/<%= listing._id %>?_method=DELETE"
        method="POST"
      >
        <button class="btn btn-dark" type="submit">
          Delete
        </button> 
      </form>
    </div>
  </div>
</div>