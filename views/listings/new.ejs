<% layout("/layouts/boilerplate.ejs") %>
<div class="row">
  <div class="col-8 offset-2">
    <h3 class="mt-3 mb-3">Create a new List</h3>
    <form action="/listings" method="POST" novalidate class="needs-validation" >
      <div class="mb-3">
        <label for="title" class="form-label">Enter Title</label>
        <input name="listing[title]" type="text" class="form-control" required/>
        <div class="valid-feedback">Title looks good</div>
        <div class="invalid-feedback">Title is required</div>
      </div>
      <div class="mb-3">
        <label for="description" class="form-label">Enter Description</label>
        <textarea name="listing[description]" type="text" id="description" class="form-control" required></textarea>
        <div class="invalid-feedback">Please enter valid Description</div>
      </div>
      <div class="mb-3">
        <label for="image" class="form-label">Enter Image link</label>
        <input name="listing[image]" placeholder="enter image URL/Link" type="text" class="form-control" />
      </div>
      <div class="row mb-3">
        <div class="col-md-4">
          <label for="price" class="form-label">Enter price</label>
          <input name="listing[price]" type="number" class="form-control" required/>
          <div class="invalid-feedback">Enter valid price</div>
        </div>
        <div class="col-md-8">
          <label for="country" class="form-label">Enter country name</label>
          <input name="listing[country]" type="text" class="form-control" required/>
          <div class="invalid-feedback">Country name is required</div>
        </div>
      </div>
      <div class="mb-3">
        <label for="location" class="form-label">Enter location</label>
        <input name="listing[location]" type="text" class="form-control" required/>
        <div class="invalid-feedback">Please enter valid location</div>
      </div>
      <div class="mb-3">
        <button type="submit" class="btn add-btn">Add</button>
      </div>
      <br />
      <br />
    </form>
  </div>
</div>
<%# <script src="/js/script.js"></script> %>